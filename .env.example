# Bu dosyanin adi ".env" olacak sekilde kopyala; asla commit etme.
# .env dosyasi .gitignore'da.

# --- Egitim (training/) ---
# Faz 1 teacher distillation icin gerekli; Kemal'in Anthropic hesap anahtari.
ANTHROPIC_API_KEY=

# Yedek: Anthropic quota dolarsa DeepSeek V3 API'sine dus.
DEEPSEEK_API_KEY=

# Hugging Face token (write scope) — model + dataset upload icin gerekli.
HF_TOKEN=

# Opsiyonel: Weights & Biases egitim takibi.
WANDB_API_KEY=
WANDB_PROJECT=reprompt

# --- Inference (src/reprompt/) ---
# Kullanicinin GGUF model dosyasinin tam yolu. Zorunlu.
REPROMPT_MODEL_PATH=~/.reprompt/models/reprompt.gguf

# Varsayilan hedef, gorev ve ayrinti profilleri.
REPROMPT_TARGET=claude-code
REPROMPT_TASK=auto
REPROMPT_DETAIL=balanced

# Alternatif config yaml yolu.
REPROMPT_CONFIG=

# Log seviyesi: DEBUG | INFO | WARN | ERROR
REPROMPT_LOG_LEVEL=INFO

# llama-cli binary yolu (PATH'te degilse).
REPROMPT_LLAMA_BIN=

# --- API Sunucusu (reprompt serve) ---
# Inference backend: llama | llama-py
REPROMPT_BACKEND=llama

# GPU'ya yuklenecek katman sayisi.
REPROMPT_GPU_LAYERS=33

# Context pencere boyutu.
REPROMPT_CTX_SIZE=8192
